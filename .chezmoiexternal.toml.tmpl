[".config/alacritty/themes"]
  type = "git-repo"
  url = "https://github.com/alacritty/alacritty-theme.git"
  refreshPeriod = "168h"
  [".config/alacritty/themes".pull]
    args = ["--rebase"]

{{ if .is_work -}}
[".work-external"]
  type = "git-repo"
  url = "git@github.com:jdaftari-confluent/dotfiles.git"
  refreshPeriod = "168h"
  [".work-external".pull]
    args = ["--rebase"]
{{ end -}}
