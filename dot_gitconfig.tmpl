[credential]
	helper = osxkeychain
[color]
	ui = true
[core]
	editor = $(brew --prefix)/bin/nvim
	excludesfile = ~/.gitignore
	ignorecase = false
	pager = delta
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[fetch]
	prune = true
	recurseSubmodules = true
	writeCommitGraph = false
[include]
	path = .gitlocal
{{- if .is_work }}
[include]
	path = .gitconfig_work
{{- end }}
[interactive]
	diffFilter = delta --color-only --features=interactive
[merge]
	tool = vimdiff
	conflictStyle = zdiff3
[mergetool]
	prompt = true
[mergetool "vimdiff"]
	cmd = nvim -f -c \"Gdiff\" \"$MERGED\"
[pull]
	rebase = true
[push]
	default = simple
[rebase]
	instructionFormat = %s%nexec GIT_COMMITTER_DATE=\"%cI\" GIT_COMMITTER_NAME=\"%cN\" GIT_COMMITTER_EMAIL=\"%cE\" git commit --amend --no-edit%n
[rerere]
	enabled = true
[user]
	email = {{ .email }}
	name = {{ .name }}
[delta]
	navigate = true
	syntax-theme = Solarized (light)
[maintenance]
	auto = false
[gc]
	auto = 0
[init]
	defaultBranch = main
[advice]
	detachedHead = false
